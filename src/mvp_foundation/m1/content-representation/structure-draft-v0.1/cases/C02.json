            "note": "将三处对话框条件串为一段；人物插画不是人数统计依据。"
          },
          "content": [
            {
              "type": "text",
              "text": "气象小组有12人。摄影小组的人数是气象小组的"
            },
            {
              "type": "math",
              "expression": {
                "op": "fraction",
                "args": [
                  {
                    "op": "number",
                    "value": "1"
                  },
                  {
                    "op": "number",
                    "value": "3"
                  }
                ]
              }
            },
            {
              "type": "text",
              "text": "。航模小组的人数是摄影小组的"
            },
            {
              "type": "math",
              "expression": {
                "op": "fraction",
                "args": [
                  {
                    "op": "number",
                    "value": "3"
                  },
                  {
                    "op": "number",
                    "value": "4"
                  }
                ]
              }
            },
            {
              "type": "text",
              "text": "。"
            }
