    {
      "id": "E-GIVEN",
      "owner": "TI-CHAIN",
      "role": "question",
      "origin": "textbook",
      "content": [
        {
          "type": "text",
          "text": "气象小组有12人。摄影小组人数是气象小组的1/3，航模小组人数是摄影小组的3/4。航模小组有多少人？说明思路。"
        }
      ],
      "sourceRefs": [
        {
          "page": "P49",
          "rect": [
            0.12,
            0.22,
            0.8,
            0.32
          ]
        }
      ]
    },
    {
      "id": "E-SOL-A",
      "owner": "SI-CHAIN-A",
      "role": "solution",
      "origin": "textbook",
      "content": [
        {
          "type": "text",
          "text": "先求摄影小组人数，再求航模小组人数。"
        },
        {
          "type": "formula",
          "expression": {
            "op": "multiply",
            "args": [
              {
                "op": "multiply",
                "args": [
                  {
                    "op": "number",
                    "value": "12"
                  },
                  {
                    "op": "fraction",
                    "args": [
                      {
                        "op": "number",
                        "value": "1"
                      },
                      {
                        "op": "number",
                        "value": "3"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "fraction",
                "args": [
                  {
                    "op": "number",
                    "value": "3"
                  },
                  {
                    "op": "number",
                    "value": "4"
                  }
                ]
              }
            ]
          },
          "latex": "12\\times\\frac13\\times\\frac34"
        },
        {
          "type": "formula",
          "expression": {
            "op": "equal",
            "args": [
              {
                "op": "multiply",
                "args": [
                  {
                    "op": "number",
                    "value": "4"
                  },
                  {
                    "op": "fraction",
                    "args": [
                      {
                        "op": "number",
                        "value": "3"
                      },
                      {
                        "op": "number",
                        "value": "4"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "number",
                "value": "3"
              }
            ]
          },
          "latex": "4\\times\\frac34=3"
        }
      ],
      "sourceRefs": [
        {
          "page": "P50",
          "rect": [
            0.07,
            0.09,
            0.85,
            0.18
          ]
        }
      ]
    },
    {
      "id": "E-SOL-B",
      "owner": "SI-CHAIN-B",
      "role": "solution",
      "origin": "textbook",
      "content": [
        {
          "type": "text",
          "text": "先求航模小组人数占气象小组的几分之几。"
        },
        {
          "type": "formula",
          "expression": {
            "op": "multiply",
            "args": [
              {
                "op": "number",
                "value": "12"
              },
              {
                "op": "group",
                "args": [
                  {
                    "op": "multiply",
                    "args": [
                      {
                        "op": "fraction",
                        "args": [
                          {
                            "op": "number",
                            "value": "1"
                          },
                          {
                            "op": "number",
                            "value": "3"
                          }
                        ]
                      },
                      {
                        "op": "fraction",
                        "args": [
                          {
                            "op": "number",
                            "value": "3"
                          },
                          {
                            "op": "number",
                            "value": "4"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
