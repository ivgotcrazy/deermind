{
  "type": "object",
  "properties": {
    "claim_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "DIRECTIONAL"
          ]
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement"
      ],
      "additionalProperties": false
    },
    "epistemic_uncertainty": {
      "type": "string"
    },
    "epistemic_status": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "content_hash": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "version",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer"
                },
                "content_hash": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id",
                "version",
                "revision",
                "content_hash"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "evidence_refs",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "prior_belief_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "revision": {
              "type": "integer"
            },
            "content_hash": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "revision",
            "content_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "inference_semantics_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "inference_rationale": {
      "type": "string"
    }
