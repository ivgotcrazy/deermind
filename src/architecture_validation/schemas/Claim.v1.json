        "allowed_support": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "learner_owned",
        "allowed_support"
      ],
      "additionalProperties": false
    },
    "quality_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disconfirmation_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "claim_type",
    "scope_ref",
    "conditions",
    "responsibility_boundary",
    "quality_requirements",
    "disconfirmation_criteria"
