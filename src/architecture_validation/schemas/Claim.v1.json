{
  "type": "object",
  "properties": {
    "claim_type": {
      "type": "string",
      "enum": [
        "TaskProficiency",
        "KC"
      ]
    },
    "scope_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "content_hash": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "revision",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibility_boundary": {
      "type": "object",
      "properties": {
        "learner_owned": {
          "type": "array",
          "items": {
            "type": "string"
          }
