{
  "components": {
    "schemas": {
      "AccountView": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "student",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "usage_gaps": {
            "items": {
              "$ref": "#/components/schemas/UsageGap"
            },
            "title": "Usage Gaps",
            "type": "array"
          }
        },
        "required": [
          "account_id",
          "display_name",
          "role",
          "usage_gaps"
        ],
        "title": "AccountView",
        "type": "object"
      },
      "ConfirmUsageRequest": {
        "additionalProperties": false,
        "properties": {
          "confirmation": {
            "$ref": "#/components/schemas/ConfirmationInput"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "expected_revision",
          "confirmation"
        ],
        "title": "ConfirmUsageRequest",
        "type": "object"
      },
      "ConfirmUsageResponse": {
        "additionalProperties": false,
        "properties": {
          "request_ref": {
            "format": "uuid",
            "title": "Request Ref",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/ConfirmationResult"
          }
        },
        "required": [
          "request_ref",
          "result"
        ],
        "title": "ConfirmUsageResponse",
        "type": "object"
      },
      "ConfirmationInput": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "accepted",
              "declined",
              "pending"
            ],
            "title": "Decision",
            "type": "string"
          },
          "kind": {
            "enum": [
              "guardian_consent",
              "student_assent"
            ],
            "title": "Kind",
            "type": "string"
          },
          "notice_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "occurred_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "source_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "student_id": {
            "format": "uuid",
            "title": "Student Id",
            "type": "string"
          }
        },
        "required": [
          "student_id",
          "kind",
          "notice_ref",
          "decision",
          "source_ref"
        ],
        "title": "ConfirmationInput",
        "type": "object"
      },
      "ConfirmationResult": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "conditions_revision": {
            "title": "Conditions Revision",
            "type": "integer"
          },
          "confirmation_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/UsageGap"
            },
            "title": "Gaps",
            "type": "array"
          }
        },
        "required": [
          "confirmation_ref",
          "conditions_revision",
          "allowed",
          "gaps"
        ],
        "title": "ConfirmationResult",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "issues": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Issues",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "issues",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "description": "报告就绪状态，不暴露连接配置或数据库内部信息。",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Ref": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "revision": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "type": {
            "minLength": 1,
            "title": "Type",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "owner",
          "type",
          "id"
        ],
        "title": "Ref",
        "type": "object"
      },
      "SessionView": {
        "additionalProperties": false,
        "description": "session_id是诊断身份；浏览器登录秘密只通过HttpOnly Cookie传递。",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "account",
          "session_id",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "description": "长度及限额由已确认的部署配置校验；不截断密码。",
        "properties": {
          "login_identifier": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Login Identifier",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "return_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return To"
          }
        },
        "required": [
          "login_identifier",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignInResponse": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "return_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return To"
          }
        },
        "required": [
          "account",
          "expires_at",
          "return_to"
        ],
        "title": "SignInResponse",
        "type": "object"
      },
      "SignOutResponse": {
        "additionalProperties": false,
        "properties": {
          "signed_out": {
            "const": true,
            "default": true,
            "title": "Signed Out",
            "type": "boolean"
          }
        },
        "title": "SignOutResponse",
        "type": "object"
      },
      "UsageGap": {
        "additionalProperties": false,
        "description": "未满足的使用条件；本轮不推定监护和使用确认已完成。",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "title": "UsageGap",
        "type": "object"
      },
      "UsageView": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "can_confirm": {
            "title": "Can Confirm",
            "type": "boolean"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/UsageGap"
            },
            "title": "Gaps",
            "type": "array"
          },
          "notice_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "notice_text": {
            "title": "Notice Text",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "source_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "student_id": {
            "format": "uuid",
            "title": "Student Id",
            "type": "string"
          }
        },
        "required": [
          "student_id",
          "revision",
          "notice_ref",
          "notice_text",
          "source_ref",
          "allowed",
          "gaps",
          "can_confirm"
        ],
        "title": "UsageView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DeerMind M1",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/m1/auth/session": {
      "get": {
        "operationId": "auth_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Client Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Current Session",
        "tags": [
          "authentication"
        ]
      }
    },
