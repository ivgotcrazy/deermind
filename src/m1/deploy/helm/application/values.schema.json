{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "filesClaim",
    "temporal",
    "nodeSelector",
    "resources",
    "database",
    "auth",
    "messaging"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": ["server", "client"],
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "filesClaim": {
      "type": "string",
      "minLength": 1
    },
    "nodeSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "temporal": {
      "type": "object",
      "required": ["address", "namespace", "taskQueue"],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "taskQueue": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["api", "worker", "client"],
      "additionalProperties": {
        "type": "object",
        "required": ["requests", "limits"],
        "properties": {
          "requests": {
            "type": "object",
            "required": ["cpu", "memory"],
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1
              },
              "memory": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "limits": {
            "type": "object",
            "required": ["cpu", "memory"],
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1
              },
              "memory": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "initializeNamespace": {
      "type": "boolean"
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "existingSecret"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["origins", "localHttp", "trustedProxies"],
      "additionalProperties": false,
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "localHttp": {
          "type": "boolean"
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "messaging": {
      "type": "object",
      "required": ["address", "deployment", "existingSecret"],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
