# Copy to .env in the repository root. Environment variables take precedence.
# Never commit a real API key.
DEERMIND_LLM_API_KEY=
DEERMIND_LLM_BASE_URL=https://api.deepseek.com
DEERMIND_LLM_MODEL=deepseek-flash
# Initial smoke run: one generation + one independent validation, no retries.
DEERMIND_LLM_MAX_CALLS=2
DEERMIND_LLM_MAX_OUTPUT_TOKENS=1024
# Local serialized messages character limit (not provider tokens).
DEERMIND_LLM_MAX_INPUT_CHARS=64000
DEERMIND_LLM_TIMEOUT_SECONDS=60
